select (ogrenci.ogr_adi + '' + ogrenci.ogr_soyadi) as ogrenci, 
bolum.bolum_ad as bolum
from ogrenci
join bolum on ogrenci.bolum_id = bolum.bolum_id
where ogrenci.adres = 'Kayseri' and bolum.bolum_ad = 'bilgisayar'

select o.ogr_adi, o.ogr_soyadi, b.bolum_ad from ogrenci as o
join bolum as b on b.bolum_id = o.bolum_id
where o.adres = 'Kayseri' and b.bolum_ad= 'bilgisayar'
