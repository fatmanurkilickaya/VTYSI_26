create database galeri
use galeri
create table musteri(
mNo int identity(1,1) not null primary key,
mAdi nvarchar(50),
mSoyadi nvarchar(50),
mAdres nvarchar(150),
mTelefon nvarchar(50)
);


insert into musteri values ('Fatma Nur', 'Kılıçkaya','Kayseri','555')
select * from musteri where mNo = 1

create table araclar(
aracNo int identity(1,1) not null primary key,
model nvarchar(50),
Marka nvarchar(50),
Plaka nvarchar(150),
Fiyat float,
yil date 
);

create table satislar(
aracNo int foreign key(aracNo) references araclar(aracNo),
satisNo int primary key not null identity(1,1),
mNo int foreign key(mNo) references musteri(mNo),
sTarih datetime,
sFiyat float
);
create table alislar(
aracNo int foreign key(aracNo) references araclar(aracNo),
alisNo int primary key not null identity(1,1),
mNo int foreign key(mNo) references musteri(mNo),
aTarih datetime,
aFiyat float
);
use galeri
select * from araclar;
select * from musteri;
select * from satislar;
select * from alislar

